{
  "name": "panel-administrativo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:app\" \"npm:dev:worker\"",
    "dev:app": "vite --config app/vite.config.ts",
    "dev:worker": "wrangler dev",
    "build": "vite build --config app/vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate:local": "wrangler d1 execute panel-lefinor --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute panel-lefinor --remote --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "octokit": "^4.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.6.0",
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^3.91.0"
  }
}
